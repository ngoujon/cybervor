# Copier en .env et remplir.
# Adresse publique (IP ou domaine) annoncée aux joueurs pour rejoindre les serveurs de jeu.
PUBLIC_HOST=203.0.113.10
# Secrets : générer des valeurs longues et aléatoires (ex. : openssl rand -hex 32).
CYBERVOR_TOKEN_SECRET=remplacer-par-un-secret-long
CYBERVOR_SERVER_SECRET=remplacer-par-un-autre-secret
CYBERVOR_ADMIN_SECRET=secret-pour-lire-les-retours-joueurs
# Adresse d'écoute de l'API méta (ex. 127.0.0.1:8095 derrière nginx)
META_BIND=8080
# Plage de ports UDP des parties créées par les joueurs (une partie = un port)
GAME_PORT_MIN=7810
GAME_PORT_MAX=7829
MAX_ROOMS=12
# META_DOMAIN=api.cybervor.exemple.fr
